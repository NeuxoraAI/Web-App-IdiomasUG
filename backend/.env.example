# Copia este archivo como .env (en la raíz del repositorio) y llena los valores.
# .env ya está en .gitignore: NUNCA lo subas a GitHub.

# --- Dónde está MongoDB ---
# Local (MongoDB Community instalado en tu computadora o en Docker):
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas (nube): copia la cadena desde Atlas → Connect → Drivers → Python
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos
MONGODB_DB=idiomas_ug

# --- Secreto para guardar las claves de acceso cifradas (hash) ---
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Debe ser el mismo en el script de carga y en el servidor web, y NO cambiar
# durante una convocatoria (si cambia, ninguna clave entregada funcionará).
CLAVE_PEPPER=cambia-esto-por-un-valor-largo-y-aleatorio
